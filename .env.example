# Waline 评论服务端地址。不设置时组件默认用 https://comment.harlon.wang。
# 本地联调或指向其他部署时可覆盖，例如指向 Vercel 部署地址：
# PUBLIC_WALINE_SERVER_URL=https://waline-comment.vercel.app
PUBLIC_WALINE_SERVER_URL=https://comment.harlon.wang

# 掘金文章同步（scripts/juejin-sync.mjs）。从浏览器 DevTools 抓取，Cookie 有效期约一年。
# JUEJIN_AID=2608
# JUEJIN_UUID=你的用户 UUID
# JUEJIN_COOKIE=登录 Cookie
# JUEJIN_CSRF_TOKEN=SecSDK CSRF Token

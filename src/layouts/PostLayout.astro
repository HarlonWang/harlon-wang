---
import BaseLayout from './BaseLayout.astro';
import TranslationBanner from '@/components/TranslationBanner.astro';
import TranslationFooter from '@/components/TranslationFooter.astro';
import Comments from '@/components/Comments.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { data } = entry;
const isTranslation = data.type === 'translation';
const dateText = data.publishDate.toISOString().slice(0, 10);

const badgeMap = {
  translation: '🌐 译文',
  'ai-led': '🤖 AI 写',
  'co-authored': '🤝 协作',
  'human-led': '✍️ 我写',
} as const;

const badge = isTranslation
  ? badgeMap.translation
  : badgeMap[data.authorship ?? 'human-led'];
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    <header>
      <h1>{data.title}</h1>
      <p class="post-meta">
        <time datetime={dateText}>{dateText}</time>
        <span> · </span>
        <span>{badge}</span>
        {isTranslation && data.translator && (
          <>
            <span> · </span>
            <span>译者 {data.translator}</span>
          </>
        )}
      </p>
    </header>

    {isTranslation && data.source && (
      <TranslationBanner source={data.source} translator={data.translator} />
    )}

    <slot />

    {isTranslation && data.source && <TranslationFooter source={data.source} />}
  </article>

  {data.comments !== false && <Comments />}
</BaseLayout>

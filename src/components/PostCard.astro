---
import type { CollectionEntry } from 'astro:content';
import { getPostBadge } from '@/utils/post-badge';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { data } = entry;
const dateText = data.publishDate.toISOString().slice(0, 10);
const badge = getPostBadge(entry);
const category =
  data.type === 'translation' ? 'translation' : data.authorship ?? 'human-led';
---

<article class="post-card" data-category={category}>
  <h3 class="post-card-title">
    <span class="post-badge">{badge}</span>
    <a href={`/posts/${entry.id}/`}>{data.title}</a>
  </h3>
  <p class="post-card-meta">
    <time datetime={dateText}>{dateText}</time>
    {
      data.type === 'translation' && data.source && (
        <span> · 译自 {data.source.siteName}</span>
      )
    }
  </p>
  <p class="post-card-desc">{data.description}</p>
</article>

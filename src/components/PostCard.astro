---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { data } = entry;
const dateText = data.publishDate.toISOString().slice(0, 10);

const badgeMap = {
  translation: '🌐 译',
  'ai-led': '🤖 AI 写',
  'co-authored': '🤝 协作',
  'human-led': '✍️ 我写',
} as const;

const badge =
  data.type === 'translation'
    ? badgeMap.translation
    : badgeMap[data.authorship ?? 'human-led'];
---

<article class="post-card">
  <h3 class="post-card-title">
    <a href={`/posts/${entry.id}/`}>{data.title}</a>
  </h3>
  <p class="post-card-meta">
    <span class="post-card-badge">{badge}</span>
    <time datetime={dateText}>{dateText}</time>
    {
      data.type === 'translation' && data.source && (
        <span> · 译自 {data.source.siteName}</span>
      )
    }
  </p>
  <p class="post-card-desc">{data.description}</p>
</article>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const featuredProducts = (await getCollection('products', ({ data }) => data.featured))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Harlon Wang" description="Harlon Wang 的个人网站 — 文章、产品、关于">
  <section class="hero">
    <h1>Harlon Wang</h1>
    <p class="hero-tagline">写代码、做开源、写文章。</p>
    <p class="hero-tagline">专注 Android、Kotlin Multiplatform 与 AI 工具。</p>
  </section>

  {
    latestPosts.length > 0 && (
      <>
        <h2 class="section-title">最新文章</h2>
        <ul style="list-style:none;padding:0;">
          {latestPosts.map((p) => (
            <li style="margin: 0.5em 0;">
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <span style="color: var(--color-muted); margin-left: 0.5em; font-size: 0.9em;">
                {p.data.publishDate.toISOString().slice(0, 10)}
              </span>
            </li>
          ))}
        </ul>
        <p>
          <a href="/posts">查看全部文章 →</a>
        </p>
      </>
    )
  }

  {
    featuredProducts.length > 0 && (
      <>
        <h2 class="section-title">精选作品</h2>
        <ul style="list-style:none;padding:0;">
          {featuredProducts.map((p) => {
            const href = p.data.links?.website ?? p.data.links?.github ?? '#';
            return (
              <li style="margin: 0.5em 0;">
                <a href={href} target="_blank" rel="noopener"><strong>{p.data.name}</strong></a>
                <span style="color: var(--color-muted); margin-left: 0.5em;">
                  — {p.data.description_zh}
                </span>
              </li>
            );
          })}
        </ul>
        <p>
          <a href="/products">查看全部作品 →</a>
        </p>
      </>
    )
  }
</BaseLayout>
